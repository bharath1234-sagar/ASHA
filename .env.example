# Copy to .env (or run: python scripts/setup_env.py). NEVER commit .env. Placeholders only below.

# Required. Generated for you by scripts/setup_env.py (encrypts transcripts and forms in SQLite).
VFR_ENCRYPTION_KEY=

# mock = runs with no external services (default). gnani = live Gnani STT/TTS
PROVIDER=mock

# Needed only when PROVIDER=gnani. Take URLs/headers from the OFFICIAL Gnani docs only.
GNANI_API_KEY=
GNANI_STT_WS_URL=
GNANI_TTS_WS_URL=

# auto = Gemini if GEMINI_API_KEY is set, otherwise the offline rule-based mock extractor
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 1 = disable every danger rule that is not marked verified (currently ALL are unverified)
DANGER_REQUIRE_VERIFIED=0
HOST=127.0.0.1
PORT=8000
